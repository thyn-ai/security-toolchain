{
  "_comment": [
    "Cases for the Decide step of .github/workflows/dependabot-auto-merge.yml, run by",
    "tests/test_dependabot_auto_merge.py: each `env` overrides the eligible baseline below, and the",
    "step must produce `decision` (and, for a skip, a reason containing `reason_contains`) or exit",
    "with `exit_code` after printing `output_contains`. Every `skip \"...\"` and `refuse \"...\"` in the",
    "script must be reached by at least one case; the test derives those lists from the script, not",
    "from a number here."
  ],
  "baseline": {
    "EVENT_NAME": "pull_request_target",
    "ACTOR": "dependabot[bot]",
    "PR_NUMBER": "39",
    "PR_AUTHOR": "dependabot[bot]",
    "PR_STATE": "open",
    "PR_DRAFT": "false",
    "CROSS_REPOSITORY": "false",
    "ALLOW_AUTO_MERGE": "true",
    "AUTO_MERGE_ENABLED_BY": "",
    "UPDATE_TYPE": "version-update:semver-minor",
    "AUTO_MERGE_MAJORS": "false",
    "MERGE_METHOD": "squash",
    "REVIEWER": "codna-ai",
    "REVIEWER_REVIEW": "APPROVED",
    "REVIEW_DECISION": "APPROVED",
    "UNRESOLVED_THREADS": "0"
  },
  "cases": [
    {"name": "minor update, codna approved, no threads: enabled", "env": {}, "expect": {"decision": "enable"}},
    {"name": "patch update is enabled", "env": {"UPDATE_TYPE": "version-update:semver-patch"}, "expect": {"decision": "enable"}},
    {"name": "grouped update reports its highest change (minor)", "env": {"PR_NUMBER": "39", "UPDATE_TYPE": "version-update:semver-minor"}, "expect": {"decision": "enable"}},
    {"name": "rebase merge method passes validation", "env": {"MERGE_METHOD": "rebase"}, "expect": {"decision": "enable"}},
    {"name": "merge merge method passes validation", "env": {"MERGE_METHOD": "merge"}, "expect": {"decision": "enable"}},
    {"name": "repository without a review rule has an empty review decision: enabled", "env": {"REVIEW_DECISION": ""}, "expect": {"decision": "enable"}},
    {"name": "codna review submitted event: the reviewer is the actor, still enabled", "env": {"EVENT_NAME": "pull_request_review", "ACTOR": "codna-ai[bot]"}, "expect": {"decision": "enable"}},
    {"name": "a human's review submitted after codna's: re-evaluated, still enabled", "env": {"EVENT_NAME": "pull_request_review", "ACTOR": "0xamlab"}, "expect": {"decision": "enable"}},
    {"name": "major stays open by default", "env": {"UPDATE_TYPE": "version-update:semver-major"}, "expect": {"decision": "skip", "reason_contains": "semver-major"}},
    {"name": "major is enabled only when the caller opts in", "env": {"UPDATE_TYPE": "version-update:semver-major", "AUTO_MERGE_MAJORS": "true"}, "expect": {"decision": "enable"}},
    {"name": "requirement-range change has no update-type and stays open", "env": {"UPDATE_TYPE": ""}, "expect": {"decision": "skip", "reason_contains": "no update-type"}},
    {"name": "an update-type this script does not know stays open", "env": {"UPDATE_TYPE": "security-update"}, "expect": {"decision": "skip", "reason_contains": "unrecognised update-type"}},
    {"name": "codna has not reviewed yet (the opened event)", "env": {"REVIEWER_REVIEW": ""}, "expect": {"decision": "skip", "reason_contains": "codna-ai has not reviewed yet"}},
    {"name": "codna commented without approving", "env": {"REVIEWER_REVIEW": "COMMENTED"}, "expect": {"decision": "skip", "reason_contains": "is COMMENTED, not APPROVED"}},
    {"name": "codna requested changes", "env": {"REVIEWER_REVIEW": "CHANGES_REQUESTED"}, "expect": {"decision": "skip", "reason_contains": "is CHANGES_REQUESTED, not APPROVED"}},
    {"name": "codna approval dismissed by a rebase (stale review dismissal)", "env": {"REVIEWER_REVIEW": "DISMISSED"}, "expect": {"decision": "skip", "reason_contains": "is DISMISSED, not APPROVED"}},
    {"name": "codna approved but left LOW findings as unresolved threads", "env": {"UNRESOLVED_THREADS": "2"}, "expect": {"decision": "skip", "reason_contains": "2 unresolved review thread(s)"}},
    {"name": "a human requested changes over codna's approval", "env": {"REVIEW_DECISION": "CHANGES_REQUESTED"}, "expect": {"decision": "skip", "reason_contains": "review decision is CHANGES_REQUESTED"}},
    {"name": "a required human review is still outstanding", "env": {"REVIEW_DECISION": "REVIEW_REQUIRED"}, "expect": {"decision": "skip", "reason_contains": "review decision is REVIEW_REQUIRED"}},
    {"name": "not opened by dependabot", "env": {"PR_AUTHOR": "0xamlab"}, "expect": {"decision": "skip", "reason_contains": "opened by 0xamlab"}},
    {"name": "reopened by a human is not dependabot's event", "env": {"ACTOR": "0xamlab"}, "expect": {"decision": "skip", "reason_contains": "triggered by 0xamlab"}},
    {"name": "head branch in another repository", "env": {"CROSS_REPOSITORY": "true"}, "expect": {"decision": "skip", "reason_contains": "another repository"}},
    {"name": "draft", "env": {"PR_DRAFT": "true"}, "expect": {"decision": "skip", "reason_contains": "draft"}},
    {"name": "closed pull request", "env": {"PR_STATE": "closed"}, "expect": {"decision": "skip", "reason_contains": "is closed"}},
    {"name": "merged pull request", "env": {"PR_STATE": "merged"}, "expect": {"decision": "skip", "reason_contains": "is merged"}},
    {"name": "repository has allow_auto_merge off", "env": {"ALLOW_AUTO_MERGE": "false"}, "expect": {"decision": "skip", "reason_contains": "Allow auto-merge"}},
    {"name": "already enabled by a human is never overridden", "env": {"AUTO_MERGE_ENABLED_BY": "0xamlab"}, "expect": {"decision": "skip", "reason_contains": "already enabled, by 0xamlab"}},
    {"name": "already enabled by the App (a rerun) is idempotent", "env": {"AUTO_MERGE_ENABLED_BY": "algenta-sdk-sync[bot]"}, "expect": {"decision": "skip", "reason_contains": "already enabled"}},
    {"name": "a major already enabled by a human is left alone, not disabled", "env": {"UPDATE_TYPE": "version-update:semver-major", "AUTO_MERGE_ENABLED_BY": "0xamlab"}, "expect": {"decision": "skip", "reason_contains": "already enabled"}},
    {"name": "author check comes before actor check", "env": {"PR_AUTHOR": "renovate[bot]", "ACTOR": "renovate[bot]"}, "expect": {"decision": "skip", "reason_contains": "opened by renovate[bot]"}},
    {"name": "update-type gate comes before the review gate", "env": {"UPDATE_TYPE": "version-update:semver-major", "REVIEWER_REVIEW": ""}, "expect": {"decision": "skip", "reason_contains": "semver-major"}},
    {"name": "called on pull_request is a misconfiguration", "env": {"EVENT_NAME": "pull_request"}, "expect": {"exit_code": 1, "output_contains": "::error"}},
    {"name": "called on push is a misconfiguration", "env": {"EVENT_NAME": "push"}, "expect": {"exit_code": 1, "output_contains": "pull_request_target or pull_request_review (got 'push')"}},
    {"name": "pull_request_review_thread is not a trigger the pinned actionlint knows, so not accepted", "env": {"EVENT_NAME": "pull_request_review_thread"}, "expect": {"exit_code": 1, "output_contains": "::error"}},
    {"name": "an unknown merge method is a misconfiguration", "env": {"MERGE_METHOD": "fast-forward"}, "expect": {"exit_code": 1, "output_contains": "merge_method must be squash, merge or rebase"}}
  ]
}
